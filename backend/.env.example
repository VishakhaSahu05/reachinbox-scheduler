NODE_ENV=development
PORT=4000
# Public URL of this API (used to build OAuth callback URLs)
APP_URL=http://localhost:4000
# Where the dashboard runs; users are sent back here after login
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox
REDIS_URL=redis://127.0.0.1:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Slack app (https://api.slack.com/apps), scope: incoming-webhook
# Slack needs an https redirect URL, so point it at a tunnel (ngrok / cloudflared) to port 4000:
# SLACK_REDIRECT_URI=https://<your-tunnel>/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Scheduler tuning
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard cap per sender per window (0 = off). Campaigns can set a lower limit of their own.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Cap across all senders per window (0 = off)
MAX_EMAILS_PER_HOUR=0
# Length of a rate-limit window. Keep 3600000 (1 hour); shrink it only to demo window roll-over quickly.
RATE_LIMIT_WINDOW_MS=3600000
SEND_MAX_ATTEMPTS=3

# smtp = real Ethereal SMTP, stub = don't open SMTP connections (load testing)
MAIL_TRANSPORT=smtp
# On first boot this many Ethereal accounts are created automatically...
ETHEREAL_SENDER_COUNT=3
# ...unless you list your own:
# ETHEREAL_SENDERS=[{"name":"Sales","user":"xxx@ethereal.email","pass":"yyy"}]

LOG_LEVEL=info

# Public hostname of the server (e.g. the Azure VM's DNS name). Caddy gets the HTTPS certificate for it.
DOMAIN=reachinbox-demo.centralindia.cloudapp.azure.com

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string

# Google OAuth: add https://<DOMAIN>/api/auth/google/callback as a redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reachinbox-demo.centralindia.cloudapp.azure.com/api/auth/google/callback

# Slack app: add https://<DOMAIN>/api/slack/callback as a redirect URL
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://reachinbox-demo.centralindia.cloudapp.azure.com/api/slack/callback

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_EMAILS_PER_HOUR=0
RATE_LIMIT_WINDOW_MS=3600000
SEND_MAX_ATTEMPTS=3
MAIL_TRANSPORT=smtp
ETHEREAL_SENDER_COUNT=3
LOG_LEVEL=info
